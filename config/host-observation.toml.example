# Merge this server-wide feature into the daemon configuration (not tasks).
# Keep build.run_as_user/run_as_group unchanged. No project configuration needed.
# Provision the Aqua helper separately, authorizing the DAEMON UID, not task UID.
[host_observation]
enabled = true
socket = "/Users/REPLACE_GUI_USER/.indentured-host/control.sock"
peer_uid = 501 # Replace with the selected graphical user's UID.
